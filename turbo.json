{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@neuledge/registry#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/generate-ingestion-revision.mjs"
      ]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {},
    "fix": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "release": {
      "cache": false
    }
  }
}
